<% layout("/layouts/boilarplate.ejs") %>

  <div class="row">
    <div class="col-8 offset-2">
      <br><br>
    <h3>Create a New Listing</h3>
    <form method="POST" action="/listings" class="form needs-validation" novalidate enctype="multipart/form-data">
      <div>
        <lable for="title" class="form-label">Title:</lable>
        <input name="listing[title]" placeholder="enter title" type="text" class="form-control" required />
        <div class="invalifeedbackd-">Enter a valid title</div>
        <div class="valid-feedback">Tittle accepted</div>
      </div>
      <br>
      
      <div class="mb-3">
        <lable for="descrription" class="form-label">Description:</lable>
        <textarea
        name="listing[description]"
        placeholder="enter description"
        class="form-control"
        required
      ></textarea>
      <div class="invalid-feedback">Enter a valid description</div>
      <div class="valid-feedback">Description accepted</div>
      </div>
      <br>
      
      <div class="mb-3">
        <lable for="image" class="form-label">Upload Listing Image:</lable>
        <input
        name="listing[image]"
        type="file"
        class="form-control"
        />
        
        <br>
      </div>

      <div class="row">
        <div class="mb-3 col-md-4">
          <lable for="price" class="form-label">Price:</lable>
          <input name="listing[price]" placeholder="enter price" class="form-control" required/>
          <div class="invalid-feedback">Enter a valid price</div>
          <div class="valid-feedback">Price accepted</div>
        </div>
        
        <div class="mb-3 col-md-8" >
          <lable for="country" class="form-label">Country:</lable>
          <input name="listing[country]" placeholder="enter country" type="text" class="form-control" required/>
          <div class="invalid-feedback">Enter a valid country</div>
          <div class="valid-feedback">Country accepted</div>
          
        </div>
      </div>
      <br>
      <div class="mb-3">
        <lable for="location" class="form-label">Location:</lable>
        <input
        name="listing[location]"
        placeholder="enter location"
        type="text"
        class="form-control"
        required
      />
      <div class="invalid-feedback">Enter a valid location</div>
      <div class="valid-feedback">Location accepted</div>
      </div>
      <br>
      
      
      <button class="btn btn-dark add-btn">Add</button>
      <br><br>
    </form>
    </div>
    </div>
  
