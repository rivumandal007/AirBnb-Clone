<% layout("/layouts/boilarplate.ejs") %>
<div class="row mt-3">
    <div class="col-6 offset-3 " >
        <h2>Login in WanderList</h2>
        <form action="/login" method="POST" class="form needs-validation" novalidate>
            <div class="mb-3">
                <lable class="form-lable" for="username">Username</lable>
                <input
                name="username"
                id="username"
                type="text"
                class="form-control"
                required
                >
            </div>
            <div class="valid-feedback">valid</div>
           
            <div class="mb-3">
                <lable class="form-lable" for="password">Password</lable>
                <input
                name="password"
                id="password"
                type="password"
                class="form-control"
                required
                >
            </div>
            <button class="btn btn-success">Login</button>

        </form>
    </div>
</div>
