<% layout("/layouts/boilarplate.ejs") %>
<div class="row mt-3">
    <div class="col-6 offset-3 " >
        <h2>Signup Page in Wanderlust</h2>
        <form action="/signup" method="POST" class="form needs-validation" novalidate>
            <div class="mb-3">
                <lable class="form-lable" for="username">Username</lable>
                <input
                name="username"
                id="username"
                type="text"
                class="form-control"
                required
                >
            </div>
            <div class="valid-feedback">Enter a valid username</div>
            <div class="mb-3">
                <lable class="form-lable" for="email">Email</lable>
                <input
                name="email"
                id="email"
                type="email"
                class="form-control"
                required
                >
            </div>
            <div class="mb-3">
                <lable class="form-lable" for="password">Password</lable>
                <input
                name="password"
                id="password"
                type="password"
                class="form-control"
                required
                >
            </div>
            <button class="btn btn-success">Submit</button>

        </form>
    </div>
</div>